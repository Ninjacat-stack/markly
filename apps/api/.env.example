# Copy to .env and fill in. Never commit real secrets.
PORT=4000
AI_SERVICE_URL=http://127.0.0.1:8001
# Optional in Phase 1; when unset the API runs in-memory.
MONGODB_URI=
RATE_LIMIT_PER_MIN=60
# Phase 9: auth (open dev mode unless AUTH_REQUIRED=1).
JWT_SECRET=change-me-in-production
AUTH_REQUIRED=0
# Phase 9: background jobs via BullMQ (in-process queue when unset).
REDIS_URL=
# Phase 4: PDF compile command ({dir} holds doc.tex). Default uses docker;
# on Windows with Docker inside WSL set: wsl docker run --rm -v "$(wslpath '{dir}'):/work" -w /work texlive/texlive:latest pdflatex -interaction=nonstopmode -halt-on-error doc
PDF_COMPILE_CMD=
