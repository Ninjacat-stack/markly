{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Markly.local/schemas/assignment/v1.json",
  "title": "Assignment",
  "description": "Canonical Assignment JSON (Phase 1). LLM generates content only; templates control presentation.",
  "type": "object",
  "required": ["title", "aim", "objectives", "theory", "steps", "conclusion"],
  "properties": {
    "experimentNumber": { "type": ["integer", "null"], "minimum": 1 },
    "title": { "type": "string", "minLength": 4, "maxLength": 200 },
    "aim": { "type": "string", "minLength": 4, "maxLength": 2000 },
    "objectives": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": { "type": "string", "minLength": 4, "maxLength": 500 }
    },
    "theory": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "description": "Concept paragraphs; no viva questions.",
      "items": { "type": "string", "minLength": 10, "maxLength": 2000 }
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["number", "title", "description"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 2, "maxLength": 200 },
          "description": {
            "type": "array", "minItems": 1, "maxItems": 10,
            "items": { "type": "string", "minLength": 4, "maxLength": 2000 }
          },
          "code": { "type": ["string", "null"], "maxLength": 8000 },
          "language": { "type": ["string", "null"], "maxLength": 32 }
        },
        "additionalProperties": false
      }
    },
    "conclusion": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "metadata": { "type": "object", "additionalProperties": true, "default": {} }
  },
  "additionalProperties": false
}

